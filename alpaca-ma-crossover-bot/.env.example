# Copy this file to .env and fill in your own PAPER trading keys from
# https://app.alpaca.markets/paper/dashboard/overview
# Never commit the real .env file - it's already in .gitignore.

ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_key_here

# Leave unset to default to the paper endpoint. Do not point this at the
# live-trading URL until the strategy has a real track record on paper.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
