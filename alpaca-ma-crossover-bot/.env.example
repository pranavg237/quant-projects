# Copy this file to .env and fill in your own PAPER trading keys from
# https://app.alpaca.markets/paper/dashboard/overview
# Never commit the real .env file - it's already in .gitignore.

ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_key_here

# Leave unset to default to the paper endpoint. Do not point this at the
# live-trading URL until the strategy has a real track record on paper.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional risk limits. CLI flags override these; the defaults are shown.
# BOT_MAX_POSITION_PCT=0.25          # max post-trade position as a fraction of equity
# BOT_MAX_POSITION_NOTIONAL=50000    # max post-trade position in dollars
# BOT_MAX_DAILY_LOSS_PCT=0.02        # block new buys once equity is 2% below the last close

# Kill switch: any value other than 0/false/no/off halts ALL order submission.
# BOT_KILL_SWITCH=1
# Or create this file (default: KILL_SWITCH next to bot.py).
# BOT_KILL_SWITCH_FILE=./KILL_SWITCH
